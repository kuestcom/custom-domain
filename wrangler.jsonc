{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kuest-custom-domain",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "DOMAIN": "example.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
